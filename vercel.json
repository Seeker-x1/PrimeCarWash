{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.xn--79q753awyk7z6a.jp"
        }
      ],
      "destination": "https://xn--79q753awyk7z6a.jp/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.出張洗車.jp"
        }
      ],
      "destination": "https://xn--79q753awyk7z6a.jp/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/threads/cron",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/threads/cron",
      "schedule": "30 21 * * *"
    }
  ]
}
